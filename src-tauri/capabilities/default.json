{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main-window dialogs, user-selected backup writes, and close protection.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-destroy",
    "dialog:allow-confirm",
    "dialog:allow-save",
    "fs:allow-write-text-file"
  ]
}
